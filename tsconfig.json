{
  "compilerOptions": {
    "declaration": true,
    "listEmittedFiles": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "sourceMap": true,
    "skipDefaultLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "useDefineForClassFields": false,
    "types": ["node"]
  },
  "include": [
    "lib/**/*.ts",
    "index.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
