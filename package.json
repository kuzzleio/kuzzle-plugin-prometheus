{
  "name": "kuzzle-plugin-prometheus",
  "version": "5.1.0-beta.1",
  "description": "Kuzzle plugin: monitoring Kuzzle using Prometheus",
  "author": {
    "name": "The Kuzzle Team <support@kuzzle.io>"
  },
  "scripts": {
    "npm:docker": "docker-compose run kuzzle npm",
    "install:docker": "npm run npm:docker install kuzzle",
    "dev:docker": "docker-compose up",
    "services": "npx kourou app:start-services",
    "prod": "node application/app.js",
    "prepack": "npm run build",
    "dev": "tsx watch --inspect=0.0.0.0:9229 application/app.ts",
    "test": "npm run test:lint && npm run test:types && npm run test:unit && npm run test:functional",
    "test:unit": "vitest run --project unit",
    "test:functional": "vitest run --project functional",
    "test:lint": "eslint .",
    "test:lint:fix": "eslint . --fix",
    "test:types": "tsc -p tsconfig.check.json",
    "build": "tsc --build tsconfig.json",
    "clean": "touch index.ts && npm run build | grep TSFILE | cut -d' ' -f 2 | xargs rm",
    "package:create": "npm run build && npm pack"
  },
  "main": "index.js",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "peerDependencies": {
    "kuzzle": ">=2.59.0 <3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuzzleio/kuzzle-plugin-prometheus.git"
  },
  "issues": "https://github.com/kuzzleio/kuzzle-plugin-prometheus/issues",
  "keywords": [
    "kuzzle",
    "plugin",
    "monitoring",
    "prometheus"
  ],
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-kuzzle": "2.0.0",
    "kuzzle": "2.59.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "maintainers": [
    {
      "name": "kuzzle",
      "email": "support@kuzzle.io"
    }
  ],
  "dependencies": {
    "kuzzle-prometheus": "1.0.0-beta.3"
  }
}
